{
  "name": "@elizaos-plugins/plugin-ankr",
  "version": "1.0.0",
  "description": "ANKR Plugin for ElizaOS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:plugins": "elizaos test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@ai-sdk/google": "^1.2.19",
    "@ai-sdk/openai": "^1.3.22",
    "@ankr.com/ankr.js": "v0.6.0",
    "@elizaos/core": "^1.0.15",
    "ai": "^4.3.16",
    "dotenv": "^16.5.0",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "eslint": "latest",
    "prettier": "latest",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "elizaos-plugin",
    "elizaos",
    "blockchain",
    "ankr",
    "web3",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/elizaos-plugins/plugin-ankr.git"
  },
  "bugs": {
    "url": "https://github.com/elizaos-plugins/plugin-ankr/issues"
  },
  "homepage": "https://github.com/elizaos-plugins/plugin-ankr#readme",
  "agentConfig": {
    "pluginType": "elizaos:client:2.0.0",
    "pluginParameters": {
      "ANKR_API_KEY": {
        "type": "string",
        "minLength": 1,
        "description": "ANKR_API_KEY is required"
      }
    }
  }
}
